{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production-readiness-payload/1.1",
  "title": "Production readiness payload",
  "description": "What the auditing agent records. scripts/readiness.py validates it, computes scores, rankings and the decision, and renders the report. Schema 1.1 adds conditional severity, evidence-required results, structured risk acceptance and scoped runs; the scorer still accepts 1.0 payloads with the 1.0 rules.",
  "type": "object",
  "required": ["schema_version", "product", "run", "surfaces", "checks"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "product": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "types": {"type": "array", "items": {"type": "string"}, "description": "e.g. saas, marketing-site, mobile-app, desktop-app, api, cli, extension, internal-tool, mcp, agent, self-hosted, offline-first, game, embedded"},
        "repository": {"type": "string"},
        "markets": {"type": "array", "items": {"type": "string"}, "description": "Where users are; drives privacy, tax, accessibility and consumer law"}
      }
    },
    "run": {
      "type": "object",
      "required": ["date", "profile"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "profile": {"enum": ["pre-launch-gate", "release-gate", "full-audit", "design-review", "spot-audit", "post-launch-health-check"]},
        "parts_in_scope": {
          "description": "\"all\" (default) or the part ids this profile covers; other parts are reported as out of scope",
          "oneOf": [{"const": "all"}, {"type": "array", "items": {"$ref": "#/$defs/partId"}}]
        },
        "surfaces_in_scope": {
          "description": "\"all\" (default) or the surface ids this run covers. A scoped run reports a decision for its scope only; it is never a whole-product readiness decision",
          "oneOf": [{"const": "all"}, {"type": "array", "items": {"type": "string"}}]
        },
        "auditor": {"type": "string"},
        "environments_examined": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "re_review": {"type": "string"}
      }
    },
    "summary": {"type": "string", "description": "Executive summary in prose: overall state, the blockers, what to do first"},
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$", "not": {"const": "all"}},
          "name": {"type": "string"},
          "kind": {"enum": ["marketing-site", "web-app", "admin-console", "public-api", "webhooks", "background-jobs", "data-pipeline", "mobile-app", "desktop-app", "extension", "cli", "sdk-library", "messaging", "docs", "store-listing", "integration", "mcp-server", "mcp-client", "agent-runtime", "self-hosted-service", "realtime-service", "device-firmware", "game", "spatial-app", "other"]},
          "location": {"type": "string"},
          "core": {"type": "boolean", "description": "True when users depend on this surface for the product's core value"},
          "notes": {"type": "string"}
        }
      }
    },
    "parts": {
      "type": "array",
      "description": "Declare parts that do not apply, with the reason",
      "items": {
        "type": "object",
        "required": ["id", "applicable"],
        "properties": {
          "id": {"$ref": "#/$defs/partId"},
          "applicable": {"type": "boolean"},
          "reason": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"applicable": {"const": false}}},
            "then": {"required": ["reason"]}
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "description": "One result per check per surface. Use surface \"all\" for product-wide checks.",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,3}-C?\\d{2,3}$", "description": "Reference check id (SEC-04) or custom (SEC-C01)"},
          "surface": {"type": "string", "default": "all"},
          "status": {"enum": ["pass", "partial", "fail", "not_verified", "not_applicable"]},
          "severity": {"enum": ["critical", "high", "medium", "low"], "description": "Severity if the check is not passing, after applying the part's severity notes"},
          "core_flow": {"type": "boolean", "description": "The check protects auth, payment, the primary value action or data integrity"},
          "evidence": {"type": "string", "description": "What was observed (command, output, file:line, measurement) or why it could not be verified / does not apply. Required for pass/partial/fail in schema 1.1, and for not_applicable in every version (it is the reason)"},
          "evidence_type": {"enum": ["observed", "inferred", "documented"]},
          "risk_accepted_by": {"type": ["string", "null"], "description": "Schema 1.0 only: the owner accepted the risk in writing. Schema 1.1 uses risk_acceptance"},
          "risk_acceptance": {
            "type": "object",
            "description": "Schema 1.1: the owner's written acceptance of an open fail/partial. Stays visible as a condition",
            "required": ["by", "reference", "date"],
            "properties": {
              "by": {"type": "string", "description": "The person who accepted the risk"},
              "reference": {"type": "string", "description": "Where the written acceptance is recorded"},
              "date": {"type": "string", "format": "date"}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"enum": ["pass", "partial", "fail", "not_verified"]}}},
            "then": {"required": ["severity"]}
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "checks", "recommendation"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "checks": {"type": "array", "items": {"type": "string"}, "description": "Check ids this finding covers: \"SEC-04\" (unique surface) or \"SEC-04@<surface>\" for a specific surface; each must have a recorded result"},
          "surfaces": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "string"},
          "user_impact": {"type": "string"},
          "business_impact": {"type": "string"},
          "recommendation": {"type": "string"},
          "effort": {"enum": ["S", "M", "L"]},
          "owner": {"type": "string", "default": "unassigned"},
          "validation": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "partId": {"enum": ["functional", "ux", "design", "accessibility", "content", "localization", "compatibility", "performance", "reliability", "observability", "infrastructure", "cost", "engineering", "security", "identity", "data", "privacy", "safety", "ai", "api", "billing", "messaging", "support", "analytics", "seo", "brand", "legal", "mobile", "desktop", "extension", "package", "launch", "mcp", "agent", "deployment", "sync", "realtime", "device", "supply-chain"]}
  }
}
